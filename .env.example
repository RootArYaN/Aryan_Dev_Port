# ---------- Shared ----------
ENVIRONMENT=development

# ---------- Frontend ----------
# The public API URL. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------- Backend ----------
APP_NAME=Aryan Enterprise Portfolio API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
AUTO_CREATE_TABLES=true

# Generate real values with: uv run python scripts/generate_secrets.py
JWT_SECRET=replace-this-before-production
APP_ENCRYPTION_KEYS=replace-with-a-valid-fernet-key
IP_HASH_PEPPER=replace-this-before-production

ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

ADMIN_EMAIL=aryantembhekar294@gmail.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Aryan Tembhekar

# Contact notification mail. Leave SMTP_HOST blank to store messages without sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=portfolio@example.com
MAIL_TO=aryantembhekar294@gmail.com

# Public rate limits per IP hash and time window.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
