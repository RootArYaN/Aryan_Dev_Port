# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Leave empty for the GitHub project URL. Set to / when using a custom domain.
VITE_BASE_PATH=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_URL=

# Backend
ENVIRONMENT=development
APP_NAME=Aryan Enterprise Portfolio API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
AUTO_CREATE_TABLES=true

# Generate these values from apps/api with:
# uv run python scripts/generate_secrets.py
JWT_SECRET=replace-with-generated-value
APP_ENCRYPTION_KEYS=replace-with-generated-fernet-key
IP_HASH_PEPPER=replace-with-generated-value

ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

ADMIN_EMAIL=aryantembhekar294@gmail.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_NAME=Aryan Tembhekar

# Leave SMTP_HOST blank to store messages without sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=portfolio@example.com
MAIL_TO=aryantembhekar294@gmail.com
MAIL_SEND_CONFIRMATION=true

CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
